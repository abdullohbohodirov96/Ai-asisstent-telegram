# ============ ABDULLOH AI ASSISTANT — SHADOW MODE V1 ============
# Hech qachon haqiqiy qiymatlarni repoga commit qilmang.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Webhook himoyasi (openssl rand -hex 32). setWebhook'dagi secret_token bilan bir xil bo'lsin.
TELEGRAM_WEBHOOK_SECRET=

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=
# Neon uchun true (default). Lokal Postgres uchun false.
DATABASE_SSL=true

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_DEEP=gemini-3.5-flash-lite
# Ixtiyoriy: ovozli xabar uchun alohida model (bo'sh = GEMINI_MODEL_FAST)
GEMINI_MODEL_TRANSCRIBE=
# Ixtiyoriy: narxlar (USD / 1M token). Masalan: {"gemini-3.5-flash-lite":{"input":0.1,"output":0.4}}
AI_PRICING_JSON=

# --- Vaqt va reportlar ---
TIMEZONE=Asia/Tashkent
REPORT_MORNING=09:00
REPORT_MIDDAY=13:00
REPORT_EVENING=18:00

# --- Tahlil ---
ANALYSIS_BATCH_MINUTES=5

# --- Cron endpointlar himoyasi (openssl rand -hex 32) ---
CRON_SECRET=

# --- Xarajat nazorati ---
MONTHLY_AI_BUDGET_USD=5
BUDGET_HARD_STOP=true
DAILY_MAX_LEARNING_QUESTIONS=5
QUESTION_HOURS_START=8
QUESTION_HOURS_END=22
TRANSCRIBE_BUSINESS_VOICE=false

# --- Shadow Mode (V1'da kod ichida qulflangan: true qilsangiz ham ishlamaydi) ---
ALLOW_AUTOREPLY=false
ALLOW_DELEGATION=false
ALLOW_PUBLISH=false

# --- Runtime ---
NODE_ENV=production
WORKER_INTERVAL_SECONDS=30
RUN_MIGRATIONS_ON_START=true
