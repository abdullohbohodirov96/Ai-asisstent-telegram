{
  "name": "abdulloh-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "ABDULLOH AI ASSISTANT \u2014 Shadow Mode V1 (Telegram Business AI Chief of Staff)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "worker": "node --env-file=.env dist/src/worker-local.js",
    "worker:dev": "tsx --env-file=.env src/worker-local.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
