# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_GROUP_CHAT_ID=your-group-chat-id
TELEGRAM_WEBHOOK_SECRET=random-secret-string

# Google Sheets (xizmat hisobi) — faqat siz Google Cloud'da service account
# yaratganingizdan keyin oling (README.md 1-qadam).
SPREADSHEET_ID=your-spreadsheet-id
SHEET_NAME=Лист1
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron himoyasi (vercel.json va GitHub Actions workflow'da ham shu qiymat
# bilan bir xil bo'lishi kerak)
CRON_SECRET=random-secret-string

# Vercel KV (Vercel dashboard > Storage > Create Database > KV qilganda
# bular avtomatik qo'shiladi, qo'lda yozish shart emas)
# KV_URL=...
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
# KV_REST_API_READ_ONLY_TOKEN=...
